{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.quirk.systems/adversarial-evaluation-suite/0-2-0.schema.json",
  "title": "Quirk Adversarial Evaluation Suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": { "const": "quirk.systems/evals/v1alpha1" },
    "kind": { "const": "AdversarialEvaluationSuite" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status", "owner"],
      "properties": {
        "id": { "pattern": "^eval\\.[a-z0-9][a-z0-9._-]*$", "type": "string" },
        "version": { "$ref": "#/$defs/SemVer" },
        "status": { "const": "candidate" },
        "owner": { "$ref": "#/$defs/Reference" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_ref",
        "manifest_schema_ref",
        "suite_schema_ref",
        "adapter_contract_version",
        "required_rule_ids",
        "default_expectation",
        "clean_context",
        "rule_cases",
        "cross_cutting_cases",
        "positive_controls"
      ],
      "properties": {
        "subject_ref": { "$ref": "#/$defs/VersionedReference" },
        "manifest_schema_ref": { "$ref": "#/$defs/Reference" },
        "suite_schema_ref": { "$ref": "#/$defs/Reference" },
        "adapter_contract_version": { "$ref": "#/$defs/SemVer" },
        "required_rule_ids": {
          "const": ["ALR-001", "ALR-002", "ALR-003", "ALR-004", "ALR-005", "ALR-006", "ALR-007", "ALR-008", "ALR-009", "ALR-010", "ALR-011"],
          "type": "array"
        },
        "default_expectation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "indeterminate"],
          "properties": {
            "result": { "const": "fail" },
            "indeterminate": { "const": "fail" }
          }
        },
        "clean_context": { "type": "object" },
        "rule_cases": {
          "type": "array",
          "minItems": 22,
          "maxItems": 22,
          "items": { "$ref": "#/$defs/RuleCase" }
        },
        "cross_cutting_cases": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/CrossCuttingCase" }
        },
        "positive_controls": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": { "$ref": "#/$defs/PositiveControl" }
        }
      }
    }
  },
  "$defs": {
    "Reference": { "minLength": 3, "maxLength": 512, "type": "string" },
    "SemVer": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "VersionedReference": {
      "pattern": "^[a-z0-9][a-z0-9._-]*@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "Expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "disposition", "findings"],
      "properties": {
        "result": { "enum": ["fail", "pass"] },
        "disposition": { "$ref": "#/$defs/Reference" },
        "findings": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Reference" }
        }
      }
    },
    "BaseCase": {
      "type": "object",
      "required": ["id", "adapter", "adversary", "fixture", "expect"],
      "properties": {
        "id": { "$ref": "#/$defs/Reference" },
        "adapter": { "pattern": "^[a-z][a-z0-9_]*$", "type": "string" },
        "adversary": { "minLength": 1, "type": "string" },
        "fixture": { "type": "object" },
        "expect": { "$ref": "#/$defs/Expectation" }
      }
    },
    "RuleCase": {
      "allOf": [
        { "$ref": "#/$defs/BaseCase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "rule_id", "adapter", "adversary", "fixture", "expect"],
          "properties": {
            "id": { "pattern": "^E-ALR-(00[1-9]|010|011)-0[12]$", "type": "string" },
            "rule_id": { "pattern": "^ALR-(00[1-9]|010|011)$", "type": "string" },
            "adapter": { "pattern": "^[a-z][a-z0-9_]*$", "type": "string" },
            "adversary": { "minLength": 1, "type": "string" },
            "fixture": { "type": "object" },
            "expect": { "$ref": "#/$defs/Expectation" }
          }
        }
      ]
    },
    "CrossCuttingCase": {
      "allOf": [
        { "$ref": "#/$defs/BaseCase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "invariant_id", "adapter", "adversary", "fixture", "expect"],
          "properties": {
            "id": { "pattern": "^E-(AUTH|TAG|MOVE)-[0-9]{3}$", "type": "string" },
            "invariant_id": { "$ref": "#/$defs/Reference" },
            "adapter": { "pattern": "^[a-z][a-z0-9_]*$", "type": "string" },
            "adversary": { "minLength": 1, "type": "string" },
            "fixture": { "type": "object" },
            "expect": { "$ref": "#/$defs/Expectation" }
          }
        }
      ]
    },
    "PositiveControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule_id", "adapter", "description", "fixture", "expect"],
      "properties": {
        "id": { "pattern": "^P-ALR-(00[1-9]|010|011)-01$", "type": "string" },
        "rule_id": { "pattern": "^ALR-(00[1-9]|010|011)$", "type": "string" },
        "adapter": { "pattern": "^[a-z][a-z0-9_]*$", "type": "string" },
        "description": { "minLength": 1, "type": "string" },
        "fixture": { "type": "object" },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "disposition", "findings"],
          "properties": {
            "result": { "const": "pass" },
            "disposition": { "const": "accept" },
            "findings": { "maxItems": 0, "type": "array" }
          }
        }
      }
    }
  }
}
